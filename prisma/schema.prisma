generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Device {
  id         String   @id @default(cuid())
  name       String
  hostname   String
  os         String?
  agentToken String   @unique
  ipAddress  String?
  owner      String?
  location   String?
  notes      String?
  loggedInUser String?
  lastSeen   DateTime @default(now())
  online     Boolean  @default(false)
  createdAt  DateTime @default(now())

  snapshots DeviceSnapshot[]
  tickets   Ticket[]
}

model DeviceSnapshot {
  id            String   @id @default(cuid())
  cpuPercent    Float?
  ramUsedGb     Float?
  ramTotalGb    Float?
  diskUsedGb    Float?
  diskTotalGb   Float?
  uptimeSeconds Int?
  createdAt     DateTime @default(now())

  device   Device @relation(fields: [deviceId], references: [id])
  deviceId String
}

model Ticket {
  id          String   @id @default(cuid())
  title       String
  description String
  status      String   @default("open")
  priority    String   @default("medium")
  category    String   @default("other")
  createdBy   String?
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  device   Device? @relation(fields: [deviceId], references: [id])
  deviceId String?

  comments TicketComment[]
}

model TicketComment {
  id         String   @id @default(cuid())
  authorName String
  content    String
  type       String   @default("note")
  createdAt  DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id])
  ticketId String
}

model AuditFinding {
  id                 String    @id @default(cuid())
  findingId          String    @unique
  title              String
  auditor            String
  date               String?
  riskRating         String
  condition          String?   @db.Text
  criteria           String?   @db.Text
  cause              String?   @db.Text
  consequence        String?   @db.Text
  correctiveAction   String?   @db.Text
  managementResponse String?   @db.Text
  status             String    @default("Draft")
  remediationDue     String?
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  history  AuditFindingHistory[]
  comments AuditFindingComment[]
}

model AuditFindingHistory {
  id        String   @id @default(cuid())
  field     String
  fromVal   String?  @db.Text
  toVal     String?  @db.Text
  user      String
  createdAt DateTime @default(now())

  finding   AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId String
}

model AuditFindingComment {
  id        String   @id @default(cuid())
  author    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  finding   AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId String
}

model AuditDoc {
  id             String   @id @default(cuid())
  title          String
  category       String   @default("Other")
  body           String   @db.Text
  tags           String[]
  pinned         Boolean  @default(false)
  starredBy      String[]
  viewCount      Int      @default(0)
  createdBy      String
  lastEditedBy   String
  fileAttachment String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  history AuditDocHistory[]
}

model AuditDocHistory {
  id        String   @id @default(cuid())
  user      String
  action    String
  createdAt DateTime @default(now())

  doc   AuditDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  docId String
}

model AuditLog {
  id        String   @id @default(cuid())
  user      String
  action    String
  itemTitle String
  itemType  String
  itemId    String
  createdAt DateTime @default(now())
}
